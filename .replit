modules = ["python-3.11"]
run = "python3 main.py"
entrypoint = "main.py"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "gunicorn -b 0.0.0.0:${PORT:-8080} -w 2 --timeout 120 main:app"]
deploymentTarget = "autoscale"
build = ["sh", "-c", "python3 site/build.py && python3 tools/package.py"]

[[ports]]
localPort = 8080
externalPort = 80

[env]
PYTHONUNBUFFERED = "1"
